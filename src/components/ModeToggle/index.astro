<!-- Toggles boring mode; state lives in the `?mode=boring` query param. -->
<button
  type="button"
  data-mode-toggle
  aria-pressed="false"
  class="inline-flex min-h-10 cursor-pointer items-center gap-2 whitespace-nowrap border border-rule px-3 text-phosphor hover:bg-phosphor hover:text-screen active:bg-hot print:hidden"
>
  <span class="size-1.5 bg-current animate-blink" aria-hidden="true"></span>
  <span>
    BORING MODE: <span class="boring:hidden">OFF</span><span class="hidden boring:inline">ON</span>
  </span>
</button>

<script>
  import { applyMode, readModeFromUrl, writeModeToUrl } from "./mode";

  applyMode(readModeFromUrl());

  document.querySelectorAll<HTMLButtonElement>("[data-mode-toggle]").forEach((button) =>
    button.addEventListener("click", () => {
      const nextMode = readModeFromUrl() === "boring" ? "fancy" : "boring";

      writeModeToUrl(nextMode);
      applyMode(nextMode);
    }),
  );
</script>
